{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iotkit.example/contracts/node-backup-header-v1.schema.json",
  "title": "IoTKit Edge Node backup container header v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_kind",
    "format_version",
    "kdf",
    "salt_b64",
    "kdf_time",
    "kdf_memory_kib",
    "kdf_parallelism",
    "cipher",
    "nonce_prefix_b64",
    "chunk_size"
  ],
  "properties": {
    "artifact_kind": { "const": "iotkit_edge_node_database" },
    "format_version": { "const": 1 },
    "kdf": { "const": "argon2id" },
    "salt_b64": { "type": "string", "pattern": "^[A-Za-z0-9+/]{21}[AQgw]$" },
    "kdf_time": { "type": "integer", "minimum": 1, "maximum": 10 },
    "kdf_memory_kib": { "type": "integer", "minimum": 16384, "maximum": 262144 },
    "kdf_parallelism": { "type": "integer", "minimum": 1, "maximum": 16 },
    "cipher": { "const": "xchacha20-poly1305" },
    "nonce_prefix_b64": { "type": "string", "pattern": "^[A-Za-z0-9+/]{21}[AQgw]$" },
    "chunk_size": { "type": "integer", "minimum": 4096, "maximum": 4194304 }
  }
}

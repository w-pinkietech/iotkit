{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iotkit.invalid/contracts/restore-receipt-v2.schema.json",
  "title": "IoTKit Edge Node restore receipt v2",
  "type": "object",
  "additionalProperties": false,
  "x-iotkit-constraints": [
    { "type": "not_equal", "left": "old_ledger_epoch", "right": "proposed_new_epoch" }
  ],
  "required": [
    "schema_version",
    "status",
    "recovery_id",
    "candidate_instance_id",
    "backup_id",
    "edge_id",
    "edge_node_id",
    "old_ledger_epoch",
    "proposed_new_epoch",
    "credential_generation",
    "device_auth_generation"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 2 },
    "status": { "const": "durably_fenced_candidate" },
    "recovery_id": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[A-Za-z0-9._-]+$" },
    "candidate_instance_id": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[A-Za-z0-9._-]+$" },
    "backup_id": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[A-Za-z0-9._-]+$" },
    "edge_id": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[A-Za-z0-9._-]+$" },
    "edge_node_id": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[A-Za-z0-9._-]+$" },
    "old_ledger_epoch": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[A-Za-z0-9._-]+$" },
    "proposed_new_epoch": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[A-Za-z0-9._-]+$" },
    "credential_generation": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
    "device_auth_generation": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 }
  }
}

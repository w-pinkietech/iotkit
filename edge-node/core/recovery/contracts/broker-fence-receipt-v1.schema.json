{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iotkit.invalid/contracts/broker-fence-receipt-v1.schema.json",
  "title": "IoTKit bundled Broker Edge Node fence receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "fence_id",
    "edge_node_id",
    "credential_generation",
    "fenced_at"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "status": { "const": "fenced" },
    "fence_id": { "type": "string", "pattern": "^fence-[0-9a-f]{32}$" },
    "edge_node_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$" },
    "credential_generation": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
    "fenced_at": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 }
  }
}

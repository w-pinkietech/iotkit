{
  "schema_version": 1,
  "notes": [
    "Path → product-doc lower bound for freshness review.",
    "Authority = docs/product/; Format = OKF v0.2; Gate = check-product-docs (iotkit-product).",
    "Empty selection is not proof that product docs need no update.",
    "doc_paths are relative to docs/product/<lang>/; both ja and en are implied."
  ],
  "rules": [
    {
      "id": "product-model",
      "path_prefixes": [
        "edge-node/apps/"
      ],
      "doc_paths": [
        "concepts/product-model.md",
        "architecture/system-overview.md"
      ],
      "rationale": "Product boundary, composition, or top-level component ownership may change."
    },
    {
      "id": "terminology",
      "path_prefixes": [
        "docs/product/en/concepts/terminology.md",
        "docs/product/ja/concepts/terminology.md"
      ],
      "doc_paths": [
        "concepts/terminology.md"
      ],
      "rationale": "Terminology corpus itself is under edit."
    },
    {
      "id": "ingest-contract",
      "path_prefixes": [
        "edge-node/ingest/",
        "edge-node/adapters/bravepi-mainboard/src/task/ingest_map.rs"
      ],
      "doc_paths": [
        "contracts/ingest-v1.md",
        "concepts/terminology.md"
      ],
      "rationale": "Device-to-Edge-Node envelope, admission, or ingest client/HTTP path."
    },
    {
      "id": "input-adapter-contract",
      "path_prefixes": [
        "edge-node/adapters/",
        "edge-node/input/"
      ],
      "doc_paths": [
        "contracts/input-adapter-v1.md"
      ],
      "rationale": "Input Adapter host, sensor drivers, or polling runtime."
    },
    {
      "id": "edge-node-core",
      "path_prefixes": [
        "edge-node/core/",
        "edge-node/apps/node/",
        "edge-node/apps/nodectl/"
      ],
      "doc_paths": [
        "architecture/system-overview.md"
      ],
      "rationale": "Edge Node core, node, or CLI changed; the architecture crate map or component responsibilities may need the same change."
    },
    {
      "id": "edge-node-recovery",
      "path_prefixes": [
        "docs/product/en/operations/installation-and-recovery.md",
        "docs/product/ja/operations/installation-and-recovery.md"
      ],
      "doc_paths": [
        "operations/installation-and-recovery.md"
      ],
      "rationale": "Edge Node replacement or three-file recovery procedure."
    },
    {
      "id": "mqtt-output-adapter-contract",
      "path_prefixes": [
        "testdata/observation/",
        "scripts/check-observation-fixtures.mjs",
        "scripts/test-observation-consumer.sh"
      ],
      "doc_paths": [
        "contracts/mqtt-output-adapter-v1.md",
        "concepts/product-model.md"
      ],
      "rationale": "MQTT Output Adapter v1 schema, fixtures, or conformance checks changed; the contract document and the Observation model may need the same change."
    },
    {
      "id": "pipeline-core",
      "path_prefixes": [
        "edge-node/core/pipeline/",
        "edge-node/core/ops/src/ops/pipeline_ops.rs",
        "edge-node/core/collector/src/pipelines.rs",
        "edge-node/apps/nodectl/src/cmd/pipeline.rs"
      ],
      "doc_paths": [
        "concepts/product-model.md",
        "contracts/mqtt-output-adapter-v1.md",
        "operations/storage-capacity.md"
      ],
      "rationale": "Pipeline definitions, evaluator semantics, series rules, publish rate, or outbox growth changed; the product model, the MQTT Output Adapter contract, and the capacity note may need the same change."
    },
    {
      "id": "mqtt-output-adapter",
      "path_prefixes": [
        "edge-node/apps/node/src/output_mqtt.rs",
        "edge-node/apps/node/src/trusted_clock.rs",
        "edge-node/input/host-api/src/lib.rs",
        "scripts/test-journey.sh",
        "scripts/journey/"
      ],
      "doc_paths": [
        "contracts/mqtt-output-adapter-v1.md",
        "concepts/product-model.md"
      ],
      "rationale": "Outbox delivery, status heartbeat, faults, Will, graceful offline, clock trust, or the end-to-end journey changed; the delivery and status sections of the contract and the Input Adapter failure behavior in the product model may need the same change."
    },
    {
      "id": "edge-node-toml-config",
      "path_prefixes": [
        "edge-node/apps/node/src/config.rs",
        "edge-node/core/types/src/lib.rs"
      ],
      "doc_paths": [
        "concepts/product-model.md",
        "contracts/mqtt-output-adapter-v1.md"
      ],
      "rationale": "Edge Node TOML tables, defaults, or identifier rules changed; the configuration ownership section and the identifier constraints may need the same change."
    },
    {
      "id": "backup-restore-ops",
      "path_prefixes": [
        "deploy/"
      ],
      "doc_paths": [
        "operations/installation-and-recovery.md"
      ],
      "rationale": "Deployment assets changed; the installation runbook may need the same change."
    },
    {
      "id": "storage-capacity",
      "path_prefixes": [
        "edge-node/apps/node/src/retention.rs",
        "edge-node/core/timeseries/"
      ],
      "notes": "Retention and the readings store are deleted in #250 5b; the device-side outbox estimate stays under pipeline-core.",
      "doc_paths": [
        "operations/storage-capacity.md",
        "architecture/system-overview.md"
      ],
      "rationale": "Storage backends, diagnostics, capacity envelopes, or PostgreSQL readiness."
    },
    {
      "id": "trial-profile",
      "path_prefixes": [
        "scripts/iotkit",
        "scripts/iotkit_trial.py",
        "deploy/compose.trial.yaml",
        "edge-node/Dockerfile"
      ],
      "doc_paths": [
        "operations/trial-profile.md"
      ],
      "rationale": "Loopback trial journey entry points."
    },
    {
      "id": "product-docs-corpus",
      "path_prefixes": [
        "docs/product/"
      ],
      "doc_paths": [],
      "rationale": "Product corpus already in the diff; still confirm bilingual pairs and revision bumps.",
      "flags": [
        "corpus_touched"
      ]
    },
    {
      "id": "product-docs-gate",
      "path_prefixes": [
        "scripts/check-product-docs.mjs",
        "scripts/check-okf-docs.mjs",
        "scripts/docs/",
        "scripts/tests/check-product-docs.test.mjs",
        "scripts/tests/product-docs-"
      ],
      "doc_paths": [
        "operations/okf-optional-meta.md"
      ],
      "rationale": "Product-doc packaging gate or frontmatter tooling; optional provenance guidance may need alignment."
    }
  ]
}

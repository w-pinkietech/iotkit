#!/usr/bin/env python3
"""check-layers — mechanically enforce the crate layer rules of the OKF architecture document.

Cargo prevents dependency *cycles*, not dependency *direction*: nothing else stops
an adapter from quietly gaining `iotkit-core-engine` or a direct data-plane
dependency. This script is the hard gate; the review guides only reference it.

Rules (see docs/product/en/architecture/system-overview.md "Layer rules"):
  1. adapters never depend on edge-node/core/engine
  2. adapters reach the data plane only through iotkit-ingest-client
  3. iotkit-ingest-contract's runtime deps are serde and nothing else
  4. edge-node/core/types and edge-node/core/storage are leaves; edge-node/core/supervision depends only on
     edge-node/core/types; edge-node/core/engine depends only on edge-node/core/types + edge-node/core/supervision; no
     edge-node/core/* crate depends on adapters or binaries
  5. a NEW workspace crate must be classified here deliberately (unclassified = error)
  6. iotkit-ingest-client's workspace deps are exactly edge-node/core/collector + the contract
  7. the frozen edge-node/core/supervision vocabulary's non-dev dependent set is pinned
  8. ingress cannot depend on the Edge/control-plane binary crate

Deliberate exception (do not "fix"): edge-node/core/registry -> edge-node/core/collector is dependency
inversion — the collector owns the RegistryPolicy trait, the registry implements it.

Normal AND build dependencies are checked (a build.rs can use the target crate at
product-build time, so a build-dep is a real edge); only dev-dependencies are
excluded (tests may cross layers).
"""

import json
import subprocess
import sys
from pathlib import Path

DATA_PLANE = {
    "iotkit-core-storage", "iotkit-core-ledger", "iotkit-core-timeseries",
    "iotkit-core-publish", "iotkit-core-collector", "iotkit-core-registry",
    "iotkit-core-ops", "iotkit-core-recovery",
}
ADAPTERS = {
    "bravepi-mainboard-adapter", "bravepi-codec", "iotkit-sensor-drivers", "bravepi-poc",
    "rpi-local-adapter", "trial-sample-adapter",
    "iotkit-polling-adapter-runtime", "rpi4b-transport",
    "iotkit-output-adapter-example",
    "iotkit-output-adapter-generic-mqtt-json-v1",
    "iotkit-output-adapter-pinikiet-mqtt-v1",
}
INPUT_ADAPTERS = {
    "bravepi-mainboard-adapter", "rpi-local-adapter", "trial-sample-adapter",
    "iotkit-polling-adapter-runtime",
}
OUTPUT_ADAPTERS = {
    "iotkit-output-adapter-example",
    "iotkit-output-adapter-generic-mqtt-json-v1",
    "iotkit-output-adapter-pinikiet-mqtt-v1",
}
BINARIES = {"iotkit-edge", "iotkit-edge-node", "iotkit-edge-nodectl"}
INGRESS = {"iotkit-ingest-http"}
CONTRACT = "iotkit-ingest-contract"
CLIENT = "iotkit-ingest-client"
HOST_API = "iotkit-input-adapter-host-api"
ADAPTER_TESTKIT = "iotkit-input-adapter-testkit"
OUTPUT_ADAPTER_API = "iotkit-output-adapter-api"
OUTPUT_ADAPTER_TESTKIT = "iotkit-output-adapter-testkit"
CUSTODY_CONTRACT = "iotkit-edge-custody-contract"
ENGINE = "iotkit-core-engine"
SUPERVISION = "iotkit-core-supervision"
TYPES = "iotkit-core-types"
STORAGE = "iotkit-core-storage"
INGRESS_ALLOWED = {CONTRACT, "iotkit-core-collector", STORAGE, "iotkit-core-ops"}
CLASSIFIED = DATA_PLANE | ADAPTERS | BINARIES | INGRESS | {
    CONTRACT, CLIENT, HOST_API, ADAPTER_TESTKIT, OUTPUT_ADAPTER_API,
    OUTPUT_ADAPTER_TESTKIT, CUSTODY_CONTRACT, ENGINE, SUPERVISION, TYPES,
}
SUPERVISION_DEPENDENTS = {
    "iotkit-core-engine",
    "iotkit-edge-node",
    "bravepi-mainboard-adapter",
    "bravepi-poc",
}


def main() -> int:
    meta = json.loads(subprocess.run(
        ["cargo", "metadata", "--no-deps", "--format-version", "1"],
        capture_output=True, check=True, text=True).stdout)
    packages = {p["name"]: p for p in meta["packages"]}
    workspace = set(packages)
    errors = []
    supervision_dependents = set()
    graph = {}

    # Executable negative fixture: parse its real Cargo graph and pass it through the same
    # rule-8 checker used for the workspace package below.
    fixture = Path(__file__).with_name("layer-fixtures") / "ingress-control-api" / "Cargo.toml"
    fixture_meta = json.loads(subprocess.run(
        ["cargo", "metadata", "--no-deps", "--format-version", "1",
         "--manifest-path", str(fixture)],
        capture_output=True, check=True, text=True).stdout)
    fixture_pkg = next(
        (p for p in fixture_meta["packages"]
         if p["name"] == "iotkit-ingest-http-negative-fixture"),
        None,
    )
    if fixture_pkg is None:
        errors.append("rule-8 negative fixture metadata omitted its package")
    else:
        fixture_internal = {
            d["name"] for d in fixture_pkg["dependencies"] if d.get("kind") != "dev"
        }
        fixture_errors = ingress_edge_errors(fixture_pkg["name"], fixture_internal)
        intended = "iotkit-edge-node"
        if len(fixture_errors) != 1 or intended not in fixture_errors[0]:
            errors.append(
                "rule-8 negative fixture did not fail for its intended ingress -> "
                f"{intended} edge: {fixture_errors!r}"
            )

    adapter_fixture = (
        Path(__file__).with_name("layer-fixtures")
        / "input-adapter-supervision"
        / "Cargo.toml"
    )
    adapter_fixture_meta = json.loads(subprocess.run(
        ["cargo", "metadata", "--no-deps", "--format-version", "1",
         "--manifest-path", str(adapter_fixture)],
        capture_output=True, check=True, text=True).stdout)
    adapter_fixture_graph = {
        package["name"]: {
            dependency["name"] for dependency in package["dependencies"]
            if dependency.get("kind") != "dev"
        }
        for package in adapter_fixture_meta["packages"]
    }
    adapter_fixture_errors = input_adapter_reachability_errors(
        "iotkit-input-adapter-negative-fixture",
        adapter_fixture_graph,
        allow_legacy_supervision=False,
    )
    if (
        len(adapter_fixture_errors) != 1
        or SUPERVISION not in adapter_fixture_errors[0]
    ):
        errors.append(
            "input-adapter transitive negative fixture did not fail for its intended "
            f"runtime -> {SUPERVISION} edge: {adapter_fixture_errors!r}"
        )

    for name in sorted(workspace - CLASSIFIED):
        errors.append(f"{name}: new crate is not classified in scripts/check-layers — "
                      f"place it in a layer deliberately, and in the OKF architecture "
                      f"map (rule 5)")

    for name, pkg in sorted(packages.items()):
        checked = [d for d in pkg["dependencies"] if d.get("kind") != "dev"]
        internal = {d["name"] for d in checked if d["name"] in workspace}
        graph[name] = internal

        if SUPERVISION in internal:
            supervision_dependents.add(name)

        if name in ADAPTERS:
            if ENGINE in internal:
                errors.append(f"{name} depends on {ENGINE} (rule 1: projection "
                              f"machinery is the Edge composition root's business)")
            direct = internal & DATA_PLANE
            if direct:
                errors.append(f"{name} depends on the data plane directly: "
                              f"{sorted(direct)} (rule 2: go through {CLIENT})")

        if name in OUTPUT_ADAPTERS:
            external = {d["name"] for d in checked}
            allowed = {OUTPUT_ADAPTER_API, "serde", "serde_json"}
            extra = external - allowed
            if extra:
                errors.append(
                    f"{name} has dependencies outside the trusted pure Output Adapter "
                    f"allowlist: {sorted(extra)}"
                )

        if name == OUTPUT_ADAPTER_API:
            external = {d["name"] for d in checked}
            extra = external - {"serde", "serde_json", "thiserror"}
            if extra:
                errors.append(
                    f"{OUTPUT_ADAPTER_API} grew dependencies beyond its leaf allowlist: "
                    f"{sorted(extra)}"
                )

        if name == CUSTODY_CONTRACT:
            external = {d["name"] for d in checked}
            extra = external - {"serde", "serde_json", "sha2", "thiserror"}
            if extra:
                errors.append(
                    f"{CUSTODY_CONTRACT} grew dependencies beyond its wire-contract "
                    f"leaf allowlist: {sorted(extra)}"
                )

        if name in INGRESS:
            errors.extend(ingress_edge_errors(name, internal))

        if name == CONTRACT:
            external = {d["name"] for d in checked}
            extra = external - {"serde"}
            if extra:
                errors.append(f"{CONTRACT} grew dependencies beyond serde: "
                              f"{sorted(extra)} (rule 3: conformance suites must be "
                              f"able to depend on this crate alone)")

        if name == CLIENT:
            expected = {"iotkit-core-collector", CONTRACT}
            if internal != expected:
                errors.append(f"{CLIENT} workspace deps are {sorted(internal)}, but "
                              f"rule 6 pins exactly {sorted(expected)} — if the binding "
                              f"design changed, update this rule and the canon deliberately")

        if name in (TYPES, STORAGE) and internal:
            errors.append(f"{name} is a leaf but depends on {sorted(internal)} (rule 4)")

        if name == SUPERVISION and internal - {TYPES}:
            errors.append(f"{SUPERVISION} may depend only on {TYPES}, found "
                          f"{sorted(internal - {TYPES})} (rule 4)")

        if name == ENGINE and internal - {TYPES, SUPERVISION}:
            errors.append(f"{ENGINE} may depend only on {TYPES} and {SUPERVISION}, found "
                          f"{sorted(internal - {TYPES, SUPERVISION})} (rule 4)")

        if name.startswith("iotkit-core-"):
            upward = internal & (ADAPTERS | BINARIES)
            if upward:
                errors.append(f"{name} depends upward on {sorted(upward)} (rule 4)")

    if supervision_dependents != SUPERVISION_DEPENDENTS:
        errors.append(
            f"{SUPERVISION} non-dev dependents are {sorted(supervision_dependents)}, "
            f"expected exactly {sorted(SUPERVISION_DEPENDENTS)}: the frozen supervision "
            f"vocabulary changes dependents (grow OR shrink) only by deliberate decision — "
            f"update SUPERVISION_DEPENDENTS and the canon's rule 7 together (rule 7) — "
            f"D4/D12決定8"
        )

    for adapter in sorted(INPUT_ADAPTERS):
        errors.extend(input_adapter_reachability_errors(
            adapter,
            graph,
            allow_legacy_supervision=adapter == "bravepi-mainboard-adapter",
        ))

    if errors:
        print("check-layers: FAIL", file=sys.stderr)
        for e in errors:
            print(f"  - {e}", file=sys.stderr)
        return 1
    print(f"check-layers: OK ({len(workspace)} crates, layer rules and ingress negative fixture hold)")
    return 0


def ingress_edge_errors(name: str, internal: set[str]) -> list[str]:
    forbidden = internal - INGRESS_ALLOWED
    if not forbidden:
        return []
    return [
        f"{name} has workspace dependencies outside the INGRESS allowlist: "
        f"{sorted(forbidden)} (rule 8: ingress is a separate listener boundary)"
    ]


def transitive_reachable(start: str, graph: dict[str, set[str]]) -> set[str]:
    seen = set()
    pending = list(graph.get(start, set()))
    while pending:
        current = pending.pop()
        if current in seen:
            continue
        seen.add(current)
        pending.extend(graph.get(current, set()) - seen)
    return seen


def input_adapter_reachability_errors(
    adapter: str,
    graph: dict[str, set[str]],
    *,
    allow_legacy_supervision: bool,
) -> list[str]:
    reachable = transitive_reachable(adapter, graph)
    errors = []
    if SUPERVISION in reachable and not allow_legacy_supervision:
        errors.append(
            f"{adapter} reaches {SUPERVISION} transitively via its production dependency "
            "graph; only BravePI's frozen legacy care path may do so"
        )
    if ENGINE in reachable:
        errors.append(
            f"{adapter} reaches {ENGINE} transitively; projection machinery belongs to Edge"
        )
    return errors


if __name__ == "__main__":
    sys.exit(main())
